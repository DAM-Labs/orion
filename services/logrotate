/var/log/orion.log {
    daily            # Rotate the log once a day
    rotate 7         # Keep 7 old log files before deleting the oldest
    compress         # Gzip old log files to save space
    delaycompress    # Wait until the next rotation to compress (useful if app still writes)
    missingok        # Don't throw an error if the log file is missing
    notifempty       # Don't rotate if the log file is empty
}
